# Copy to .env and fill in FREE-tier keys only. Never commit real secrets.
MILAN_ENV=local

# Gemini free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Optional local Ollama (no key, no cost). Enable it to join the chain.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Ordered fallback chain; put ollama first to make it primary
LLM_PROVIDER_ORDER=gemini,groq,openrouter,ollama

# Rate-limit pacing and backoff
LLM_MIN_INTERVAL_SECONDS=2.0
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=1.0

# Guardrails
MAX_TOOL_CALLS_PER_ALERT=6

# Storage (runtime artifacts are gitignored)
DUCKDB_PATH=artifacts/milan.duckdb
TELEMETRY_DIR=artifacts/telemetry
